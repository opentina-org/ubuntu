# syntax=docker/dockerfile:1.6
# OpenTina Ubuntu lite rootfs — cross-arch build via BuildKit/QEMU.
# Mirrors mk-base-ubuntu.sh's package set + user/group/system tweaks, but as a
# Dockerfile so that `docker buildx build --platform linux/arm64 -o type=tar`
# can produce a rootfs tar without ubuntu-base + chroot + qemu-user-static
# bind mounts. The Docker Hub `ubuntu:<codename>` multi-arch image is the same
# base as ubuntu-base tarball plus a few defaults; suitable for a lite rootfs.

ARG SUITE=noble
FROM ubuntu:${SUITE}

ARG SUITE=noble
ARG UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
ARG UBUNTU_PORTS_MIRROR=http://ports.ubuntu.com/ubuntu-ports
ARG ROOT_PASSWORD=root
ARG EXTRA_USER=cat
ARG EXTRA_USER_PASSWORD=temppwd
ARG EXTRA_DEBS=""
ARG SERIAL_TTY=ttyS0
ARG HOSTNAME=ubuntu-lite
ARG DESKTOP=0
ARG TIMEZONE=Asia/Shanghai

ENV DEBIAN_FRONTEND=noninteractive \
    LC_ALL=C.UTF-8

# 1. Replace default mirrors. ubuntu:<codename> uses ports for non-amd64 by
#    default, but Docker Hub's multi-arch manifest sometimes ships archive.* —
#    rewrite to either UBUNTU_MIRROR (amd64) or UBUNTU_PORTS_MIRROR (arm*).
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
    amd64) MIRROR="${UBUNTU_MIRROR}" ;; \
    *)     MIRROR="${UBUNTU_PORTS_MIRROR}" ;; \
    esac; \
    if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i "s|http://[^ ]*ubuntu[^ ]*|${MIRROR}|g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi; \
    # If we also have a /etc/apt/sources.list (older variants), rewrite it too
    # and prefer the deb822 file as the single source of truth to avoid the
    # apt warning "Target Packages ... is configured multiple times".
    if [ -f /etc/apt/sources.list ] && [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        : > /etc/apt/sources.list; \
    elif [ -f /etc/apt/sources.list ]; then \
        sed -i "s|http://[^ ]*ubuntu[^ ]*|${MIRROR}|g" /etc/apt/sources.list; \
    fi; \
    apt-get -y update; \
    apt-get -y full-upgrade; \
    apt-get -y install --no-install-recommends \
        rsyslog sudo dialog apt-utils evtest acpid \
        net-tools openssh-server ifupdown \
        inetutils-ping libssl-dev tcpdump i2c-tools strace vim iperf3 \
        ethtool toilet htop pciutils usbutils curl whiptail \
        gnupg bc gdisk parted gpiod libgpiod-dev u-boot-tools bsdmainutils \
        file fdisk locales ca-certificates \
        systemd-sysv systemd-timesyncd ${EXTRA_DEBS}; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# 1b. Optional desktop/HMI stack (DESKTOP=1): Wayland/Weston.
#     On arm64, Chromium comes from the OpenTina release .deb (with EGL OpenGL
#     ES 3.0 -> 2.0 fallback for Mesa Zink); other architectures fall back to
#     the xtradeb PPA (ubuntu's own chromium-browser is a snap shim).
#     Mesa from the kisak-mesa PPA: noble ships 25.2, and the A733 PowerVR
#     BXM-4-64 is only known to Mesa >= 25.3. The PPA is left at its default
#     priority rather than pinned to mesa alone -- it also carries libdrm, llvm
#     and spirv-llvm-translator, which that Mesa needs.
ARG CHROMIUM_DEB_URL="https://github.com/opentina-org/chromium/releases/download/v156.0.8078.79-1%2Bopentina1/chromium_156.0.8078.79-1+opentina1_arm64.deb"
ARG CHROMIUM_DEB_SHA256="78e833c1312f62f7997a27ea28d4b13329270992c7953a8fcd52a9997633e454"
RUN set -eux; \
    if [ "${DESKTOP}" = "1" ]; then \
        install -d /etc/apt/keyrings; \
        use_opentina_chromium=0; \
        if [ "$(dpkg --print-architecture)" = "arm64" ] && [ -n "${CHROMIUM_DEB_URL}" ]; then \
            use_opentina_chromium=1; \
        else \
            curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x5301FA4FD93244FBC6F6149982BB6851C64F6880" \
                | gpg --dearmor -o /etc/apt/keyrings/xtradeb.gpg; \
            echo "deb [signed-by=/etc/apt/keyrings/xtradeb.gpg] https://ppa.launchpadcontent.net/xtradeb/apps/ubuntu ${SUITE} main" \
                > /etc/apt/sources.list.d/xtradeb-chromium.list; \
        fi; \
        curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xEB8B81E14DA65431D7504EA8F63F0F2B90935439" \
            | gpg --dearmor -o /etc/apt/keyrings/kisak.gpg; \
        echo "deb [signed-by=/etc/apt/keyrings/kisak.gpg] https://ppa.launchpadcontent.net/kisak/kisak-mesa/ubuntu ${SUITE} main" \
            > /etc/apt/sources.list.d/kisak-mesa.list; \
        apt-get -y update; \
        apt-get -y install --no-install-recommends \
            weston seatd xwayland \
            libgl1-mesa-dri libegl-mesa0 libglx-mesa0 libgbm1 \
            mesa-libgallium mesa-vulkan-drivers mesa-utils \
            vulkan-tools glmark2-es2-wayland \
            gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
            gstreamer1.0-plugins-bad gstreamer1.0-libav \
            gstreamer1.0-alsa gstreamer1.0-pulseaudio gstreamer1.0-gl \
            pulseaudio alsa-utils \
            fonts-dejavu-core dbus-user-session; \
        if [ "${use_opentina_chromium}" = "1" ]; then \
            case "${#CHROMIUM_DEB_SHA256}:${CHROMIUM_DEB_SHA256}" in \
                64:*[!0-9a-fA-F]*) \
                    echo "CHROMIUM_DEB_SHA256 must be a 64-character hex SHA-256 digest" >&2; \
                    exit 1 ;; \
                64:*) ;; \
                *) \
                    echo "CHROMIUM_DEB_SHA256 must be a 64-character hex SHA-256 digest" >&2; \
                    exit 1 ;; \
            esac; \
            curl -fL --retry 3 --retry-delay 2 -o /tmp/opentina-chromium.deb "${CHROMIUM_DEB_URL}"; \
            printf '%s  /tmp/opentina-chromium.deb\n' "${CHROMIUM_DEB_SHA256}" | sha256sum --strict -c -; \
            mkdir -p /etc/apt/preferences.d; \
            printf '%s\n' \
                '# Prefer OpenTina GLES2-patched builds; keep unpatched archive builds' \
                '# below installed priority (100) and block the Ubuntu snap shim.' \
                'Package: chromium' \
                'Pin: version *+opentina*' \
                'Pin-Priority: 990' \
                '' \
                'Package: chromium chromium-common chromium-sandbox chromium-l10n' \
                'Pin: release *' \
                'Pin-Priority: 50' \
                '' \
                'Package: chromium-browser' \
                'Pin: release *' \
                'Pin-Priority: -1' \
                > /etc/apt/preferences.d/opentina-chromium; \
            apt-get -y install --no-install-recommends /tmp/opentina-chromium.deb; \
            rm -f /tmp/opentina-chromium.deb; \
        else \
            apt-get -y install --no-install-recommends chromium; \
        fi; \
        test -x /usr/bin/chromium; \
        printf '%s\n' 'PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1' >> /etc/environment; \
        apt-get clean; \
        rm -rf /var/lib/apt/lists/*; \
    fi

# 2. Locale, timezone, hostname, /sbin/init fallback.
RUN set -eux; \
    sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen; \
    locale-gen; \
    update-locale LANG=en_US.UTF-8; \
    ln -sf "/usr/share/zoneinfo/${TIMEZONE}" /etc/localtime; \
    echo "${TIMEZONE}" > /etc/timezone; \
    echo "${HOSTNAME}" > /etc/hostname; \
    if [ ! -e /sbin/init ] && [ ! -e /usr/sbin/init ]; then \
        ln -sf /lib/systemd/systemd /usr/sbin/init; \
    fi

# 3. Root password + extra user with passwordless sudo + gpio group.
RUN set -eux; \
    echo "root:${ROOT_PASSWORD}" | chpasswd; \
    groupadd -f --system gpio 2>/dev/null || true; \
    if [ -n "${EXTRA_USER}" ]; then \
        if ! id -u "${EXTRA_USER}" >/dev/null 2>&1; then \
            useradd -G sudo -m -s /bin/bash "${EXTRA_USER}"; \
            echo "${EXTRA_USER}:${EXTRA_USER_PASSWORD}" | chpasswd; \
        fi; \
        gpasswd -a "${EXTRA_USER}" gpio 2>/dev/null || true; \
        gpasswd -a "${EXTRA_USER}" video 2>/dev/null || true; \
        gpasswd -a "${EXTRA_USER}" audio 2>/dev/null || true; \
        gpasswd -a "${EXTRA_USER}" i2c 2>/dev/null || true; \
    fi; \
    sed -i '/pam_securetty.so/s/^/# /g' /etc/pam.d/login 2>/dev/null || true; \
    if ! awk '$1 == "%sudo" { found=1 } END { exit !found }' /etc/sudoers; then \
        echo "%sudo	ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers; \
    else \
        sed -i -e '/\%sudo/ c %sudo    ALL=(ALL) NOPASSWD: ALL' /etc/sudoers; \
    fi

# 4. /etc/fstab + systemd tweaks (mask -wait-online, log level/target).
RUN set -eux; \
    mkdir -p /etc/systemd/system.conf.d; \
    printf '%s\n%s\n' '[Manager]' 'DefaultTimeoutStartSec=120s' \
        > /etc/systemd/system.conf.d/opentina.conf; \
    cat > /etc/fstab <<'FSTAB'
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
proc            /proc           proc    defaults          0       0
sysfs           /sys            sysfs   defaults          0       0
tmpfs           /tmp            tmpfs   defaults,nodev,nosuid  0  0
FSTAB

RUN set -eux; \
    for s in NetworkManager systemd-networkd; do \
        systemctl mask "${s}-wait-online.service" 2>/dev/null || true; \
    done; \
    for s in 'wpa_supplicant-wired@' 'wpa_supplicant-nl80211@' 'wpa_supplicant@'; do \
        systemctl mask "${s}" 2>/dev/null || true; \
    done; \
    sed -i 's/#LogLevel=info/LogLevel=warning/' /etc/systemd/system.conf 2>/dev/null || true; \
    sed -i 's/#LogTarget=journal-or-kmsg/LogTarget=journal/' /etc/systemd/system.conf 2>/dev/null || true; \
    systemctl set-default multi-user.target; \
    systemctl enable ssh

# 5. Project overlay (BSP files, login banner, etc).
COPY overlay/ /

# HMI overlay. Staged rather than copied straight to / so that a lite image
# does not carry compositor units and demo assets it will never start.
COPY overlay-desktop/ /.opentina-desktop/
RUN set -eux; \
    if [ "${DESKTOP}" = "1" ]; then \
        cp -a /.opentina-desktop/. /; \
        chmod 0755 /usr/bin/opentina-hmi-check \
            /usr/share/opentina/demo/gst-scenarios.sh; \
        systemctl enable seatd.service; \
        systemctl enable opentina-weston.service; \
        systemctl enable opentina-kiosk.service; \
    fi; \
    rm -rf /.opentina-desktop

# 6. Enable the standard systemd serial getty. systemd-getty-generator also
# requests this same unit for console=<tty>; using a second template would
# start two agetty processes that race for input on the same serial port.
RUN set -eux; \
    systemctl disable "opentina-serial-getty@${SERIAL_TTY}.service" 2>/dev/null || true; \
    systemctl enable "serial-getty@${SERIAL_TTY}.service"

# 7. OEM injection. Customer assets are staged into .oem-staging/ by the buildx
#    wrapper (empty = no-op). Unmet deps abort the build — no `apt -f install`.
COPY .oem-staging/ /oem/
RUN set -eux; \
    if ls /oem/packages/*.deb >/dev/null 2>&1; then \
        apt-get -y update; \
        apt-get -y install --no-install-recommends /oem/packages/*.deb; \
        apt-get clean; \
        rm -rf /var/lib/apt/lists/*; \
    fi; \
    if [ -d /oem/rootfs-overlay ]; then \
        cp -a /oem/rootfs-overlay/. /; \
    fi; \
    if [ -x /oem/post.sh ]; then \
        /oem/post.sh; \
    fi; \
    rm -rf /oem

RUN printf 'OPENTINA_REVISION=Dockerfile.rootfs\nSUITE=%s\nPROFILE=%s\n' \
        "${SUITE}" "$([ "${DESKTOP}" = "1" ] && echo desktop || echo lite)" \
        > /etc/opentina-rootfs-release
